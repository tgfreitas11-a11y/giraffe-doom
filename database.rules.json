{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        "game": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || data.child('at').val() < now - 86400000)",
          ".validate": "newData.child('host').val() === auth.uid && newData.child('j').isString() && newData.child('j').val().length < 1000000"
        },
        "peers": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.child('j').isString() && newData.child('j').val().length < 20000)"
          }
        }
      }
    }
  }
}
